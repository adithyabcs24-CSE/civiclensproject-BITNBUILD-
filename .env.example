# ==============================================================================
# CivicLens AI Environment Configuration
# ==============================================================================

# Server Port (Default: 3001)
PORT=3001

# Google Gemini API Key (Optional)
# If provided, CivicLens AI uses Gemini 1.5 for dynamic extraction and reasoning.
# If omitted or offline, CivicLens AI seamlessly falls back to its grounded heuristic reasoning engine.
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative environment variable name:
# GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash
